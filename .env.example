# Existing Railway Variables stay in Railway. Do NOT upload secrets to GitHub.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_SHEETS_KEY=
VLAD_TELEGRAM_ID=
DIANA_TELEGRAM_ID=
FAMILY_CHAT_ID=
GOOGLE_CREDENTIALS_JSON=
# Attach a Railway Volume at /app/data. Paths alone do NOT create a volume!
ADA_STATE_DIR=/app/data
CHAT_HISTORY_FILE=/app/data/chat_history.json
# Original monthly automatic limit feature retained. Set false only if you want it off.
AUTO_GENERATE_LIMITS=true
SHEETS_READ_CACHE_SECONDS=10
LOG_LEVEL=INFO
